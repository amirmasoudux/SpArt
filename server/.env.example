# Copy this file to .env and fill in your own values. Never commit .env.
PORT=4000
# MongoDB Atlas connection string. Leave empty to use the built-in demo data in memory.
MONGO_URI=
# Frontend address allowed by CORS
CLIENT_URL=http://localhost:5173
# AI API (any OpenAI-compatible provider with image input)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
